# App
PORT=3000
NODE_ENV=development

# Database
# Lokal: localhost (Postgres di compose DB dengan port 5432:5432)
# Docker app + DB terpisah di network bersama: nama service Postgres, mis. postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=botuser
DB_PASSWORD=botpassword
DB_DATABASE=whatsapp_bot

# Whitelist — only these numbers can chat with the bot, others are ignored.
# Admin numbers bypass the DB whitelist and can manage it via /whitelist commands.
ADMIN_NUMBERS=628123456789

# AI provider switch — 'anthropic' (default) or 'hermes'
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Hermes — internal OpenAI-compatible gateway. Auth header is the raw key
# (no "Bearer " prefix). Model id is whatever the gateway currently routes to.
HERMES_API_KEY=sk-nous-...
HERMES_BASE_URL=http://10.20.30.50:8645/v1
HERMES_MODEL=upstage/solar-pro4:free

# OpenWeatherMap
OPENWEATHER_API_KEY=your_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
