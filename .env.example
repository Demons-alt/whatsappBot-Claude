# App
PORT=3000
NODE_ENV=development

# Database
# Lokal: localhost (Postgres di compose DB dengan port 5432:5432)
# Docker app + DB terpisah di network bersama: nama service Postgres, mis. postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=botuser
DB_PASSWORD=botpassword
DB_DATABASE=whatsapp_bot

# Whitelist — only these numbers can chat with the bot, others are ignored.
# Admin numbers bypass the DB whitelist and can manage it via /whitelist commands.
ADMIN_NUMBERS=628123456789

# AI provider switch — 'anthropic' (default) or 'chat-combos'
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ChatCombos — internal OpenAI-compatible gateway. Standard Bearer auth. Model id
# is whatever the gateway currently routes to. CHAT_COMBOS_MAX_TOKENS gives headroom
# in case the routed model spends part of its budget on hidden reasoning before the
# visible reply — bump it if responses come back empty/truncated.
CHAT_COMBOS_API_KEY=sk-...
CHAT_COMBOS_BASE_URL=http://10.20.30.50:20128/v1
CHAT_COMBOS_MODEL=chat-combos
CHAT_COMBOS_MAX_TOKENS=2048

# OpenWeatherMap
OPENWEATHER_API_KEY=your_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
